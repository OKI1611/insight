[
  {"en": "Satan entered Judas", "ko": "사탄이 유다에게 들어가니", "note": "배신이 단순한 인간적 탐욕을 넘어선 영적 사건임을 보여줌.", "voc": [["Satan", "n.", "사탄"], ["enter", "v.", "들어가다"], ["surname", "v.", "별명으로 부르다"]], "idi": [], "gra": [["being of the number", "그 수에 든 자로서(분사구문 being)"]]},
  {"en": "prepare us the passover", "ko": "유월절을 예비하라", "note": "유월절 양과 무교병, 쓴 나물 등을 갖추어 만찬을 준비하는 일로, 최후의 만찬 자리가 됨.", "voc": [["prepare", "v.", "예비하다"], ["passover", "n.", "유월절"], ["furnish", "v.", "갖추다, 차리다"]], "idi": [["prepare us the passover", "우리를 위해 유월절을 예비하라"]], "gra": [["prepare us", "us는 간접목적어(=prepare for us)"]]},
  {"en": "With desire I have desired", "ko": "간절히 원하고 원하였노라", "note": "히브리식 강조 표현으로, 고난을 앞두고 제자들과의 만찬을 향한 깊은 갈망을 드러냄.", "voc": [["desire", "v.", "원하다, 갈망하다"], ["eat", "v.", "먹다"], ["suffer", "v.", "고난받다"]], "idi": [["with desire I have desired", "간절히 사모하였노라(강조법)"]], "gra": [["With desire I have desired", "동족목적어를 더한 히브리식 강조 구문(=I have earnestly desired)"]]},
  {"en": "This is my body", "ko": "이것은 내 몸이라", "note": "성찬(주의 만찬)을 제정하신 말씀으로, 떡은 너희를 위해 내어주신 그의 몸을 가리킴.", "voc": [["body", "n.", "몸"], ["bread", "n.", "떡, 빵"], ["remembrance", "n.", "기념, 기억"]], "idi": [["in remembrance of me", "나를 기념하여"]], "gra": []},
  {"en": "the new testament in my blood", "ko": "내 피로 세우는 새 언약", "note": "예레미야 31장에 약속된 새 언약이 그의 피로 성취됨을 선언함.", "voc": [["testament", "n.", "언약, 유언"], ["blood", "n.", "피"], ["shed", "v.", "흘리다"]], "idi": [["the new testament", "새 언약"]], "gra": [["which is shed for you", "관계대명사 which + 수동태(흘려지는)"]]},
  {"en": "sift you as wheat", "ko": "밀같이 까부르려고", "note": "곡식을 키질하듯 흔들어 시험하려는 사탄의 공격을 비유함. 그러나 예수께서 베드로를 위해 기도하심.", "voc": [["sift", "v.", "체질하다, 까부르다"], ["wheat", "n.", "밀"], ["fail", "v.", "떨어지다, 실패하다"]], "idi": [["sift you as wheat", "밀까부르듯 시험하다"]], "gra": [["that thy faith fail not", "목적·결과의 that절 + 부정 어순(=that your faith may not fail)"]]},
  {"en": "the cock shall not crow", "ko": "닭이 울기 전에", "note": "베드로의 세 번 부인을 예고하신 말씀으로, 그날 밤에 그대로 이루어짐.", "voc": [["cock", "n.", "수탉"], ["crow", "v.", "(닭이) 울다"], ["deny", "v.", "부인하다"]], "idi": [], "gra": [["shall not crow", "예언적 미래를 나타내는 shall(=will not crow)"]]},
  {"en": "remove this cup from me", "ko": "이 잔을 내게서 거두어 주옵소서", "note": "겟세마네 기도. '잔'은 그가 짊어지실 고난과 진노를 상징하며, 끝내 아버지의 뜻에 복종하심.", "voc": [["remove", "v.", "거두다, 옮기다"], ["cup", "n.", "잔"], ["will", "n.", "뜻, 의지"]], "idi": [["remove this cup", "이 잔을 거두어 달라(고난을 면하게 해달라)"]], "gra": [["if thou be willing", "조건절에 가정법 be를 쓴 옛 용법(=if you are willing)"]]},
  {"en": "sweat as great drops of blood", "ko": "땀이 핏방울같이", "note": "극심한 고뇌의 표현으로, 천사가 그를 도와 굳세게 하였다 함.", "voc": [["sweat", "n.", "땀"], ["drop", "n.", "방울"], ["agony", "n.", "고뇌, 번민"]], "idi": [["great drops of blood", "큰 핏방울"]], "gra": [["as it were", "마치 ~인 듯이(삽입 관용구)"]]},
  {"en": "betrayest thou the Son of man with a kiss", "ko": "입맞춤으로 인자를 넘겨주느냐", "note": "사랑의 표시인 입맞춤이 배신의 신호로 쓰인 비극. 겟세마네에서의 체포로 이어짐.", "voc": [["betray", "v.", "넘겨주다, 배신하다"], ["kiss", "n.", "입맞춤"], ["multitude", "n.", "무리"]], "idi": [["with a kiss", "입맞춤으로"]], "gra": [["betrayest thou", "2인칭 단수 -est 어미 의문문(=do you betray)"]]},
  {"en": "the Lord looked upon Peter", "ko": "주께서 베드로를 바라보시니", "note": "세 번 부인한 베드로가 주의 눈길에 자신을 깨닫고 밖에 나가 비통하게 우니, 회복의 길로 이어지는 통회.", "voc": [["look upon", "phr.", "바라보다"], ["weep", "v.", "울다"], ["bitterly", "ad.", "비통하게"]], "idi": [["look upon", "바라보다, 주목하다"], ["weep bitterly", "비통하게 울다"]], "gra": []}
]
