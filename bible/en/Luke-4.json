[
  {"en": "led into the wilderness", "ko": "광야로 이끌리시다", "note": "성령께서 예수를 시험의 자리로 인도하시니라."},
  {"en": "forty days tempted", "ko": "사십 일 시험", "note": "금식 후 주리신 가운데 마귀의 시험을 받으시다."},
  {"en": "command this stone", "ko": "이 돌로 빵을", "note": "굶주림을 이용한 첫째 시험."},
