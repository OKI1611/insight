[
  {"en": "the hour is come", "ko": "때가 이르렀나이다", "note": "예수의 십자가와 영광의 시간이 도래했음을 알리는 선언."},
  {"en": "glorify thy Son", "ko": "아들을 영화롭게 하소서", "note": "아들의 영광이 곧 아버지의 영광으로 이어지는 상호 영화."},
  {"en": "life eternal", "ko": "영생", "note": "영생을 하나님과 그리스도를 '아는 것'으로 정의함."},
  {"en": "before the world was", "ko": "창세 이전에", "note": "성자의 선재(先在)와 영원한 영광을 가리킴."},
  {"en": "they are thine", "ko": "그들은 아버지의 것이니이다", "note": "제자들이 본래 하나님께 속함을 강조."},
  {"en": "that they may be one", "ko": "그들이 하나가 되게 하옵소서", "note": "삼위의 하나됨을 본받은 신자의 연합을 구함."},
  {"en": "the son of perdition", "ko": "멸망의 아들", "note": "가룟 유다를 가리키며 성경의 성취를 언급."},
  {"en": "keep them from the evil", "ko": "악에서 그들을 지키소서", "note": "세상에서 데려감이 아니라 악으로부터의 보호를 구함."},
  {"en": "Sanctify them through thy truth", "ko": "진리로 그들을 거룩하게 하소서", "note": "성화(거룩하게 하심)의 수단이 진리의 말씀임."},
  {"en": "made perfect in one", "ko": "온전히 하나가 되어", "note": "연합의 완성이 세상의 믿음으로 이어짐."},
  {"en": "O righteous Father", "ko": "의로우신 아버지여", "note": "하나님의 의를 부르며 기도를 맺음."},
  {"en": "the love wherewith thou hast loved me", "ko": "나를 사랑하신 그 사랑", "note": "신자 안에 거하는 하나님의 사랑을 구하며 마침."}
]
