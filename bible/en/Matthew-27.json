  {"en": "the potter's field", "ko": "토기장이의 밭", "note": "피 값으로 산 나그네 묘지. 예레미야·스가랴 예언의 성취로 제시됨.", "voc": [["potter", "n.", "토기장이, 옹기장이"], ["field", "n.", "밭, 들"]], "idi": [], "gra": [["the potter's field", "'s=소유격('토기장이의 밭')"]]},
  {"en": "Art thou the King of the Jews?", "ko": "네가 유대인의 왕이냐", "note": "빌라도의 핵심 심문. '왕'이라는 정치적 죄목으로 로마법에 걸려 함.", "voc": [["king", "n.", "왕"], ["Jew", "n.", "유대인"]], "idi": [], "gra": [["Art thou", "art=are의 고어형, thou=you('네가 ~이냐')"]]},
  {"en": "Barabbas released", "ko": "바라바를 놓아주다", "note": "폭동·살인범. 무죄한 예수 대신 풀려나는 대속의 그림.", "voc": [["release", "v.", "놓아주다, 풀어 주다"], ["Barabbas", "n.", "바라바"]], "idi": [], "gra": [["Barabbas released", "released=과거분사 수동('놓임을 받은 바라바')"]]},
  {"en": "washed his hands", "ko": "손을 씻다", "note": "빌라도의 책임 회피 행위. 그러나 판결을 내린 책임은 면치 못함.", "voc": [["wash", "v.", "씻다"], ["hand", "n.", "손"]], "idi": [["wash one's hands", "손을 씻다, 책임을 떨치다"]], "gra": []},
