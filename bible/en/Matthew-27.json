[
  {"en": "Pontius Pilate the governor", "ko": "총독 본디오 빌라도", "note": "AD 26~36년 유대 총독. 사형 집행권은 로마에게만 있어 그에게 넘겨짐.", "voc": [["governor", "n.", "총독, 지방관"], ["deliver", "v.", "넘겨주다, 인도하다"]], "idi": [], "gra": [["Pilate the governor", "동격 명사구('총독인 빌라도')"]]},
