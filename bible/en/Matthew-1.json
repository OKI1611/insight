[
  { "en": "begat", "ko": "낳았다 (beget의 과거형)", "note": "고어 동사. 족보에서 'A begat B' = 'A가 B를 낳다'. 현대영어로는 'was the father of'." },
  { "en": "the book of the generation", "ko": "계보(족보)의 책", "note": "generation = 세대·혈통·계보. 히브리어 '톨레도트(계보의 기록)' 어법(창 5:1)." },
  { "en": "carried away to Babylon", "ko": "바벨론으로 끌려감", "note": "carry away = (강제로) 데려가다 — 포로로 끌고 가다라는 숙어." },
  { "en": "on this wise", "ko": "이런 식으로 / 이러하니라", "note": "고어 표현. wise = 방식(way·manner). 'in this way'와 같음." },
  { "en": "espoused to", "ko": "~와 정혼(약혼)한", "note": "espouse = 약혼·정혼하다. 현대영어 'engaged/betrothed'." },
  { "en": "with child", "ko": "아이를 밴 (임신한)", "note": "관용구 'be with child' = pregnant(임신하다)." },
  { "en": "a just man", "ko": "의로운 사람", "note": "just = 공정한·의로운(righteous). 도덕적으로 올바른." },
  { "en": "make her a publick example", "ko": "공개적으로 본보기(망신) 삼다", "note": "관용구 'make an example of (someone)' = 본보기로 벌하다·망신 주다." },
  { "en": "put her away privily", "ko": "가만히(은밀히) 내보내다 = 조용히 파혼하다", "note": "put away = 내보내다·이혼(파혼)하다. privily = 고어 'privately(은밀히)'." },
  { "en": "fear not", "ko": "두려워 말라", "note": "고어 부정 명령형 = 'do not fear'. 성경에 가장 자주 나오는 위로의 말." },
  { "en": "bring forth a son", "ko": "아들을 낳다", "note": "관용구 'bring forth' = (열매·자식을) 낳다·산출하다." },
  { "en": "which being interpreted is", "ko": "번역(해석)하면 ~이다", "note": "being interpreted = 해석되면. 이름의 뜻을 풀이할 때 쓰는 표현(임마누엘 = God with us)." },
  { "en": "knew her not", "ko": "그녀를 가까이하지(동침하지) 아니하였다", "note": "성경에서 'know'는 부부의 잠자리를 가리키는 완곡어법. 'knew her not' = 동침하지 않았다." }
]
