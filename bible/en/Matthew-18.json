[
  {"en": "Who is greatest?", "ko": "누가 가장 큰가?", "note": "제자들이 하늘의 왕국에서 으뜸을 묻다."},
  {"en": "Become like children", "ko": "어린아이같이 되라", "note": "돌이켜 낮아져야 왕국에 들어간다."},
  {"en": "Humble yourself", "ko": "자신을 낮추라", "note": "어린아이처럼 낮추는 자가 가장 크다."},
  {"en": "Don't cause stumbling", "ko": "걸려 넘어지게 말라", "note": "작은 자를 넘어뜨리면 맷돌의 화가 낫다."},
  {"en": "Cut off what makes you sin", "ko": "죄짓게 하는 것을 끊으라", "note": "손·발·눈보다 생명이 귀하다."},
  {"en": "Don't despise little ones", "ko": "작은 자를 멸시 말라", "note": "그들의 천사가 아버지 얼굴을 뵙는다."},
  {"en": "The lost sheep", "ko": "잃은 양 한 마리", "note": "아흔아홉을 두고 잃은 하나를 찾으신다."},
  {"en": "Reprove a sinning brother", "ko": "범죄한 형제를 권면하라", "note": "단둘이, 그다음 증인, 끝으로 교회."},
  {"en": "Bind and loose", "ko": "매고 푸는 권세", "note": "땅에서 매면 하늘에서도 매인다."},
  {"en": "Two or three gathered", "ko": "두세 사람이 모인 곳", "note": "그 이름으로 모이면 거기 함께 계신다."},
  {"en": "Forgive seventy times seven", "ko": "일흔 번을 일곱 번", "note": "용서에 한계를 두지 말라."},
  {"en": "The unforgiving servant", "ko": "용서 못한 종", "note": "일만 달란트 탕감받고 백 데나리온을 조른다."}
]
