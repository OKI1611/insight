[
  {"en": "power and authority", "ko": "능력과 권세", "note": "열두 제자에게 귀신을 제어하고 병을 고치는 권한을 위임하심 (3절)"},
  {"en": "the kingdom of God", "ko": "하나님의 왕국", "note": "제자들이 전파한 핵심 메시지이자 이 장 전체의 주제어"},
  {"en": "take nothing for your journey", "ko": "길을 위하여 아무것도 가지지 말라", "note": "전적인 의탁을 가르치는 파송 지침"},
  {"en": "shake off the dust", "ko": "먼지를 떨라", "note": "영접하지 않는 성읍에 대한 증거의 행위"},
  {"en": "five loaves and two fishes", "ko": "떡 다섯 개와 물고기 두 마리", "note": "오병이어 — 오천 명을 먹이신 기적"},
  {"en": "twelve baskets", "ko": "열두 광주리", "note": "다 먹고 남은 조각의 풍성함을 보여 줌"},
  {"en": "The Christ of God", "ko": "하나님의 그리스도", "note": "베드로의 신앙 고백 — 복음서의 전환점"},
  {"en": "take up his cross daily", "ko": "날마다 자기 십자가를 지고", "note": "제자도의 핵심 — 자기 부인의 부르심"},
  {"en": "his raiment was white and glistering", "ko": "그 옷이 희어져 광채가 나더라", "note": "변화산 — 예수의 영광이 드러남"},
  {"en": "This is my beloved Son", "ko": "이는 내 사랑하는 아들이니", "note": "구름 속에서 들린 아버지의 음성 (35절)"},
  {"en": "stedfastly set his face", "ko": "굳게 얼굴을 정하시고", "note": "예루살렘을 향한 결연한 발걸음의 시작 (51절)"},
  {"en": "having put his hand to the plough", "ko": "손에 쟁기를 잡고", "note": "뒤돌아보지 않는 헌신을 요구하는 비유 (62절)"}
