  {"en": "By what authority?", "ko": "무슨 권세로?", "note": "대제사장들과 서기관들이 성전에서 가르치시는 예수께 그 행위의 권위 출처를 따져 묻는 장면(2절).", "voc": [["authority", "n.", "권세, 권위"], ["doest", "v.", "행하다(do의 고어)"], ["gave", "v.", "주었다"]], "idi": [["by what authority", "무슨 권세로"]], "gra": [["doest thou", "2인칭 단수 의문문의 옛 형태(=do you do)"]]},
  {"en": "The baptism of John", "ko": "요한의 침례", "note": "예수께서 역질문으로 되받으심. 요한의 권위가 하늘에서 왔음을 인정하면 자신의 권위도 인정해야 함을 드러내심(4절). 지침대로 '침례'로 표기.", "voc": [["baptism", "n.", "침례"], ["heaven", "n.", "하늘"], ["reason", "v.", "따져 논하다"]], "idi": [["from heaven or of men", "하늘에서냐 사람에게서냐"]], "gra": []},
  {"en": "planted a vineyard", "ko": "포도원을 일구어", "note": "포도원 농부 비유의 도입. 포도원은 이스라엘, 주인은 하나님, 농부들은 그 지도자들을 가리킴(9절).", "voc": [["plant", "v.", "심다, 일구다"], ["vineyard", "n.", "포도원"], ["husbandman", "n.", "농부, 소작인"]], "idi": [], "gra": [["let it forth", "임대하다(let=빌려주다의 옛 용법)"]]},
  {"en": "my beloved son", "ko": "내 사랑하는 아들", "note": "거듭 보낸 종들(선지자들) 뒤에 마지막으로 보내신 아들. 곧 예수 자신을 가리키는 자기 예언(13절). 농부들은 상속자인 그를 알아보고도 유산을 차지하려 죽이려 모의함(14절).", "voc": [["beloved", "a.", "사랑하는"], ["heir", "n.", "상속자"], ["inheritance", "n.", "유산, 상속"]], "idi": [["it may be", "아마도, 어쩌면"]], "gra": [["reverence him", "그를 존경하다(reverence가 타동사로 쓰인 옛 용법)"]]},
  {"en": "the head of the corner", "ko": "모퉁이의 머릿돌", "note": "시편 118편 인용. 건축자들에게 버림받은 돌이 가장 중요한 머릿돌이 됨—거부당한 메시아의 영광을 예표(17절).", "voc": [["corner", "n.", "모퉁이"], ["builder", "n.", "건축자"], ["reject", "v.", "버리다, 거부하다"]], "idi": [["the head of the corner", "모퉁이의 머릿돌(가장 중요한 자리)"]], "gra": []},
  {"en": "Render unto Caesar", "ko": "가이사의 것은 가이사에게", "note": "세금 논쟁의 핵심 답변. 동전에 새겨진 형상의 주인에게 합당한 것을 돌리라 하심으로 함정을 피하심(25절).", "voc": [["render", "v.", "돌리다, 바치다"], ["tribute", "n.", "세금, 조공"], ["image", "n.", "형상"]], "idi": [["render unto Caesar", "가이사의 것을 가이사에게 바치다"]], "gra": [["unto", "방향·대상을 나타내는 옛 전치사(=to)"]]},
  {"en": "the things which be God's", "ko": "하나님의 것은 하나님께", "note": "가이사 구절의 대구. 황제에게 속한 것과 구별하여, 인간 자신은 하나님의 형상을 지녔으므로 하나님께 속함을 함축(25절).", "voc": [["thing", "n.", "것, 일"], ["God's", "n.", "하나님의 것"], ["superscription", "n.", "새긴 글, 명문"]], "idi": [], "gra": [["which be God's", "복수 관계대명사절에 be를 쓴 옛 용법(=which are God's)"]]},
  {"en": "whose wife in the resurrection?", "ko": "부활 때에 누구의 아내?", "note": "부활을 부정하는 사두개인들이 일곱 형제와 한 아내의 가정을 들어 부활을 조롱하려 한 함정 질문(33절).", "voc": [["wife", "n.", "아내"], ["resurrection", "n.", "부활"], ["seven", "num.", "일곱"]], "idi": [["in the resurrection", "부활 때에"]], "gra": []},
  {"en": "equal unto the angels", "ko": "천사들과 같으니", "note": "부활한 자들은 장가가고 시집가는 일이 없고 다시 죽지도 않으니, 천사와 같고 부활의 자녀라 하심(36절).", "voc": [["equal", "a.", "같은, 동등한"], ["angel", "n.", "천사"], ["neither", "ad.", "~도 아니다"]], "idi": [["equal unto the angels", "천사들과 같은"]], "gra": [["neither marry, nor are given in marriage", "장가들지도 시집가지도 않는다(neither A nor B 상관접속)"]]},
  {"en": "God of the living", "ko": "산 자의 하나님", "note": "출애굽기 가시덤불 사건 인용. 하나님이 아브라함·이삭·야곱의 하나님이라 하심은 그들이 그분께 살아 있음을 뜻하여 부활을 입증(38절).", "voc": [["living", "a.", "살아 있는"], ["dead", "a.", "죽은"], ["bush", "n.", "떨기나무, 가시덤불"]], "idi": [["God of the living", "산 자의 하나님"]], "gra": []},
  {"en": "David's son and Lord", "ko": "다윗의 자손이자 주", "note": "시편 110편을 들어, 다윗이 메시아를 '주'라 불렀음을 지적하심. 그리스도가 다윗의 자손 이상의 존재임을 드러내심(41~44절).", "voc": [["son", "n.", "자손, 아들"], ["Lord", "n.", "주"], ["footstool", "n.", "발등상, 발판"]], "idi": [["make thine enemies thy footstool", "원수를 발등상으로 삼다"]], "gra": [["thine enemies", "모음 앞에서 thy 대신 쓰인 thine(=your)"]]},
  {"en": "Beware of the scribes", "ko": "서기관들을 삼가라", "note": "긴 옷·높은 자리를 즐기고 과부의 집을 삼키며 외식하는 서기관들을 경계하라 하심. 더 무거운 정죄를 경고(46~47절).", "voc": [["beware", "v.", "삼가다, 조심하다"], ["scribe", "n.", "서기관"], ["devour", "v.", "삼키다, 집어삼키다"]], "idi": [["beware of", "~을 조심하라"], ["for a shew", "겉보기로, 외식으로"]], "gra": []}
