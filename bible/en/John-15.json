  {"en": "Abide in me", "ko": "내 안에 거하라", "note": "헬라어 메노(μένω), 머물러 떠나지 아니함. 본 장의 핵심 어구로 거듭 반복된다.", "voc": [["abide", "v.", "거하다, 머물다"], ["branch", "n.", "가지"]], "idi": [["abide in", "~안에 거하다, 계속 머물다"]], "gra": []},
  {"en": "without me", "ko": "나를 떠나서는", "note": "원문 코리스 에무(χωρὶς ἐμοῦ), '나와 분리되어서는'의 뜻. 그리스도께 연합함이 모든 열매의 근원이다.", "voc": [["without", "prep.", "~없이, ~을 떠나서"], ["nothing", "pron.", "아무것도 (아니다)"]], "idi": [["without me", "나를 떠나서는, 나와 분리되어서는"]], "gra": [["without", "여기서는 '밖에'가 아니라 '~없이'의 옛 용법"]]},
  {"en": "cast forth as a branch", "ko": "가지처럼 밖에 버려지다", "note": "거하지 아니하는 자의 운명을 마른 가지에 빗댄 경고.", "voc": [["cast", "v.", "던지다, 버리다"], ["branch", "n.", "가지"], ["wither", "v.", "마르다, 시들다"]], "idi": [["cast forth", "밖으로 내던지다, 버리다"]], "gra": []},
  {"en": "ask what ye will", "ko": "원하는 대로 구하라", "note": "그분의 말씀이 안에 거할 때 비로소 기도가 그 뜻에 합하게 됨을 전제한다.", "voc": [["ask", "v.", "구하다, 청하다"], ["will", "v.", "원하다, 바라다"]], "idi": [], "gra": [["ye", "you(너희)의 고어 주격 형태"], ["what ye will", "여기 will은 조동사가 아니라 '원하다'라는 본동사"]]},
  {"en": "continue ye in my love", "ko": "내 사랑 안에 머물러 있으라", "note": "메노의 명령형. '거하라'와 같은 동사로, 사랑 안에 지속적으로 머묾을 권면한다.", "voc": [["continue", "v.", "계속하다, 머물러 있다"], ["love", "n.", "사랑"]], "idi": [["continue in", "~안에 계속 머물다"]], "gra": [["continue ye", "명령문에서 주어 ye를 동사 뒤에 둔 고어 어순, 현대어 continue"]]},
