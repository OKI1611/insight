[
  {"en": "held a consultation", "ko": "의논하여 결의하다", "note": "산헤드린 공회가 새벽에 모여 정식으로 결정을 내림"},
  {"en": "delivered him to Pilate", "ko": "빌라도에게 넘기다", "note": "사형 집행권이 없는 공회가 로마 총독에게 인계함"},
  {"en": "Thou sayest it", "ko": "네 말이 그러하다", "note": "긍정도 부정도 아닌 의미심장한 응답; '네가 그렇게 말하는도다'"},
  {"en": "answered nothing", "ko": "아무 대답도 하지 않다", "note": "이사야 53:7의 '잠잠한 어린 양' 성취"},
  {"en": "Pilate marvelled", "ko": "빌라도가 놀라다", "note": "피고가 변호하지 않는 침묵에 총독이 의아해함"},
  {"en": "released one prisoner", "ko": "죄수 하나를 놓아 주다", "note": "유월절 명절의 사면 관례"},
  {"en": "insurrection", "ko": "폭동·반란", "note": "로마에 대한 무장 봉기; 바라바는 이 일로 살인한 자"},
  {"en": "crying aloud", "ko": "큰 소리로 외치다", "note": "무리가 관례대로 사면을 요청하기 시작함"},
  {"en": "King of the Jews", "ko": "유대인의 왕", "note": "빌라도가 반어적으로 사용한 정치적 호칭"},
  {"en": "for envy", "ko": "시기심 때문에", "note": "지도자들의 진짜 동기를 빌라도가 간파함"},
  {"en": "moved the people", "ko": "무리를 충동하다", "note": "대제사장들이 군중을 선동함"},
  {"en": "What will ye", "ko": "너희가 무엇을 원하느냐", "note": "빌라도가 군중에게 책임을 떠넘기듯 되물음"},
  {"en": "Crucify him", "ko": "십자가에 못 박으라", "note": "로마의 가장 잔혹한 처형 방식을 요구함"},
  {"en": "what evil hath he done", "ko": "무슨 악을 행하였느냐", "note": "빌라도가 예수의 무죄를 사실상 인정함"},
  {"en": "scourged", "ko": "채찍질하다", "note": "납·뼈가 박힌 채찍(flagellum)으로 매질하는 로마형"},
  {"en": "Praetorium", "ko": "관정·총독 관저", "note": "로마 총독의 공관 뜰; 음역 '브라이도리온'"},
  {"en": "purple", "ko": "자색 옷", "note": "왕의 색; 예수를 거짓 왕으로 조롱함"},
  {"en": "Hail, King of the Jews", "ko": "유대인의 왕 만세", "note": "카이사르 경례를 흉내 낸 조롱"},
  {"en": "bowing their knees", "ko": "무릎 꿇어 절하다", "note": "거짓 경배로 모욕함"},
  {"en": "mocked him", "ko": "그를 희롱하다", "note": "조롱을 마친 뒤 자기 옷을 다시 입힘"},
  {"en": "compel", "ko": "억지로 시키다", "note": "로마 군인의 강제 징발권; 시몬에게 십자가를 지움"},
  {"en": "Golgotha", "ko": "골고다", "note": "아람어 '해골'; 라틴어로 갈보리(Calvary)"},
  {"en": "wine mingled with myrrh", "ko": "몰약 탄 포도주", "note": "고통을 더는 마취 음료; 예수께서 거절하심"},
  {"en": "casting lots", "ko": "제비를 뽑다", "note": "시편 22:18 성취; 군병들이 옷을 나눔"},
  {"en": "the third hour", "ko": "제삼시(오전 9시)", "note": "유대식 시간 계산"},
  {"en": "superscription", "ko": "죄패의 글", "note": "처형 죄목을 적은 명패(titulus)"},
  {"en": "two thieves", "ko": "두 강도", "note": "좌우에 함께 처형된 죄수들"},
  {"en": "numbered with the transgressors", "ko": "범죄자로 헤아려지다", "note": "이사야 53:12의 예언 성취"},
  {"en": "wagging their heads", "ko": "머리를 흔들다", "note": "조롱·멸시의 몸짓; 시편 22:7"},
  {"en": "come down from the cross", "ko": "십자가에서 내려오라", "note": "구원자를 자칭하는 그를 향한 비웃음"},
  {"en": "himself he cannot save", "ko": "자기는 구원하지 못한다", "note": "역설적 진리: 남을 구하려 스스로 내려오지 않으심"},
  {"en": "that we may see and believe", "ko": "보고 믿겠다", "note": "표적을 조건으로 내건 불신앙의 요구"},
  {"en": "darkness over the whole land", "ko": "온 땅의 어둠", "note": "심판과 애통의 표징; 제육시~제구시"},
  {"en": "lama sabachthani", "ko": "어찌하여 나를 버리셨나이까", "note": "아람어; 시편 22:1의 부르짖음"},
  {"en": "he calleth Elias", "ko": "엘리야를 부른다", "note": "'엘리'를 엘리야로 오해한 구경꾼들"},
  {"en": "spunge full of vinegar", "ko": "식초 적신 해면", "note": "신 포도주(posca); 시편 69:21"},
  {"en": "gave up the ghost", "ko": "영혼을 내어 주다", "note": "스스로 목숨을 내려놓으심을 강조하는 표현"},
  {"en": "veil of the temple was rent", "ko": "성전 휘장이 찢어지다", "note": "지성소로의 길이 열림; 위로부터 아래까지"},
  {"en": "Son of God", "ko": "하나님의 아들", "note": "이방인 백부장의 신앙 고백"},
  {"en": "looking on afar off", "ko": "멀리서 바라보다", "note": "끝까지 곁을 지킨 여인들"},
  {"en": "ministered unto him", "ko": "그를 섬기다", "note": "갈릴리부터 따르며 시중든 제자들"},
  {"en": "the preparation", "ko": "예비일", "note": "안식일 전날, 곧 금요일"},
  {"en": "waited for the kingdom of God", "ko": "하나님의 왕국을 기다리다", "note": "요셉의 메시아 소망; 담대히 시신을 구함"},
  {"en": "marvelled if he were already dead", "ko": "벌써 죽었을까 의아해하다", "note": "십자가형은 보통 더 오래 걸림"},
  {"en": "gave the body to Joseph", "ko": "시신을 요셉에게 내주다", "note": "백부장 확인 후 매장을 허락함"},
  {"en": "fine linen", "ko": "고운 세마포", "note": "장례용 천; 바위 무덤에 안치함"},
  {"en": "beheld where he was laid", "ko": "모신 곳을 지켜보다", "note": "여인들이 무덤 위치를 목격함; 부활 증인의 기초"}
]
