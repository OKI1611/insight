{
  // 바이블 인사이트 = Cloudflare Worker(정적 자산 + 결제 API 코드)
  // main 이 추가되면서 "자산 전용 Worker" → "자산 + 코드 Worker"로 승격됩니다.
  //   1) 사이트는 그대로 서빙(env.ASSETS)  2) /api/pay/* 결제 동작  3) 환경변수 사용 가능
  "name": "insight",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 기본값은 '정적 자산이 있으면 Worker를 건너뛰고 바로 서빙'이라 /watch 는 Worker 코드가 실행되지 않았다.
    // 강의별 og 메타 주입(worker/index.js watchMeta)을 위해 이 두 경로만 Worker를 먼저 태운다. 나머지는 그대로 자산 우선.
    "run_worker_first": ["/watch", "/watch.html"]
  }
}
